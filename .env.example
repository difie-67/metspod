# Telegram: token from @BotFather
BOT_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE

# Numeric Telegram ID(s) of arbiters/admins, comma-separated
ARBITER_TG_IDS=123456789

# TON network
TON_NETWORK=mainnet
TON_ENDPOINT=https://toncenter.com/api/v2/jsonRPC
TON_API_KEY=

# Service wallet — 24-word mnemonic. Never commit a real mnemonic.
ARBITER_MNEMONIC=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12 word13 word14 word15 word16 word17 word18 word19 word20 word21 word22 word23 word24

# V4 address derived from service-wallet mnemonic
EXPECTED_SERVICE_WALLET_ADDRESS=EQxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public address for the 2% platform fee
PLATFORM_ADDRESS=UQxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Fee: 200 = 2%
FEE_BPS=200

# TON reserves for contract deployment and actions
ESCROW_GAS_TON=0.04
ACTION_GAS_TON=0.05
WALLET_FEE_RESERVE_TON=0.02

# TON RPC reliability
RPC_TIMEOUT_MS=12000
RPC_RETRIES=3
POLL_INTERVAL_MS=20000

# Deal limits
MIN_DEAL_TON=0.01
MAX_DEAL_TON=100
MAX_ACTIVE_DEALS_PER_USER=10

# Mini App
# For Railway later: https://your-project.up.railway.app
MINI_APP_URL=
MINI_APP_PORT=3000
MINI_APP_AUTH_MAX_AGE_SECONDS=86400
SUPPORT_USERNAME=admssupport_bot

# Database
DB_PATH=./data/escrow.sqlite
